(text "STATE MACHINE FF" (rect 1232 48 1362 63)(font "Arial" (font_size 8)))
(text "0 = WAITING STATE" (rect 1232 64 1360 79)(font "Arial" (font_size 8)))
(text "1 = REQUESTING STATE" (rect 1232 80 1396 95)(font "Arial" (font_size 8)))
(text "STATE MACHINE LOGIC" (rect 792 -88 950 -73)(font "Arial" (font_size 8)))
(text "THE STATE MACHINE ENTERS THE REQUESTING STATE" (rect 792 -56 1171 -41)(font "Arial" (font_size 8)))
(text "WHEN IACKIN IS NEGATED AND AN INTERRUPT" (rect 792 -40 1112 -25)(font "Arial" (font_size 8)))
(text "REQUEST IS PENDING" (rect 792 -24 945 -9)(font "Arial" (font_size 8)))
(text "IT WILL REMAIN IN THIS STATE WHEN THE INTERRUPT" (rect 792 8 1161 23)(font "Arial" (font_size 8)))
(text "REQUEST IS CLEARED AS LONG AS IACKIN IS STILL" (rect 792 24 1141 39)(font "Arial" (font_size 8)))
(text "WAITING STATE" (rect 792 56 897 71)(font "Arial" (font_size 8)))
(text "IACKOUNT MAY BE ASSERTED WHEN:" (rect 1704 -24 1958 -9)(font "Arial" (font_size 8)))
(text "1. THE STATE MACHINE IS IN THE WAITING STATE" (rect 1704 8 2036 23)(font "Arial" (font_size 8)))
(text "AND IACKIN IS ASSERTED" (rect 1704 24 1878 39)(font "Arial" (font_size 8)))
(text "2. THE STATE MACHINE IS IN THE REQUESTING STATE" (rect 1704 56 2072 71)(font "Arial" (font_size 8)))
(text "AND IACKIN IS ASSERTED AND THE ACKNOWLEDGED" (rect 1704 72 2068 87)(font "Arial" (font_size 8)))
(text "INTERRUPT LEVEL DOES NOT MATCH" (rect 1704 88 1961 103)(font "Arial" (font_size 8)))
(text "THE INTERRUPT IS AUTOVECTORED WHEN THE STATE" (rect 1704 256 2079 271)(font "Arial" (font_size 8)))
(text "MACHINE ISI N THE REQUESTING STATE AND IACKIN IS" (rect 1704 272 2076 287)(font "Arial" (font_size 8)))
(text "ASSERTED AND AUTOVEC IS LOGIC HIGH AND THE" (rect 1704 288 2049 303)(font "Arial" (font_size 8)))
(text "ACKNOWLEDGED INTERRUPT LEVEL MATCHES" (rect 1704 304 2028 319)(font "Arial" (font_size 8)))
(text "THE INTERRUPT IS VECTORED WHEN THE STATE" (rect 1704 408 2041 423)(font "Arial" (font_size 8)))
(text "MACHINE IS IN THE REQUESTING STATE AND IACKIN IS" (rect 1704 424 2076 439)(font "Arial" (font_size 8)))
(text "ASSERTED AND AUTOVEC IS LOGIC LOW AND THE" (rect 1704 440 2046 455)(font "Arial" (font_size 8)))
(text "LOWER DATA STROBE IS ASSERTED AND THE" (rect 1704 456 2016 471)(font "Arial" (font_size 8)))
(text "ACKNOWLEDGED INTERRUPT LEVEL MATCHES" (rect 1704 472 2028 487)(font "Arial" (font_size 8)))
(text "ACKD IS SET WHEN THE STATE MACHINE IS IN THE" (rect 1704 584 2049 599)(font "Arial" (font_size 8)))
(text "REQUESTING STATE AND IACKIN IS ASSERTED AND" (rect 1704 600 2055 615)(font "Arial" (font_size 8)))
(text "THE ACKNOWLEDGED INTERRUPT LEVEL MATCHES." (rect 1704 616 2063 631)(font "Arial" (font_size 8)))
(text "IT IS CLEARED WHEN THE IPL RETURNS TO LEVEL 0." (rect 1704 632 2065 647)(font "Arial" (font_size 8)))
(text "ASSERTED, AFTER WHICH IT WILL RETURN TO THE" (rect 792 40 1141 55)(font "Arial" (font_size 8)))
